      &quot;passengerId&quot;: &quot;${passengerId}&quot;,&#xd;
      &quot;seatType&quot;: 0&#xd;
    }&#xd;
  ],&#xd;
  &quot;chooseSeats&quot;: []&#xd;
}</stringProp>
